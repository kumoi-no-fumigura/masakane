 "poems": [
  {
   "seq": "1",
   "text": "うくひすの木つたふさまもゆかしきに今一聲は明はてゝなけ",
   "kana": "",
   "speaker": "雅兼卿集",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "さくら花まつ咲山のはつ風はほかよりさきにいとはれやする",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "花さそふ嵐や峯をわたるらむさくらなみよる谷川の水",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "風ふけは波のあやをる池水にいとひきそふる岸の靑柳",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "咲しよりいくかきぬらむ朝霞たつたの山の花のあたりに",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "なみたてる松もや風をいとふらんあたりの花の散かおしさに",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "年每にさきそふ宿のさくら花猶行末の春そゆかしき",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "苔むしろみとりの色はうつもれて散しく花にしく物そなき",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "こけむしろありけるものを散花にしく物なしと思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "波のよるせゝの末まてかほるなりこれや梅津のなかれ成覽",
   "kana": "",
   "speaker": "みつくもとまらさりけり",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "さきそめしはしめもしらぬ櫻花いく春風に匂ひきぬらん",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "花ゆへにけふのおしさはかゝるかと常盤の里の人にとはゝや",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "〔本ノマヽ〕心してひけたかせ船きしの山吹にほふさかりそ",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "五月やみ芦まのほたるほの〓〓と見ゆるや淀の渡りなるらん",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "五月雨の空のなたてに郭公きゝつとかたる人たにもなき",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "かへるさの道のしるへと宮城のゝ花まつ萩をしほりてそ行",
   "kana": "",
   "speaker": "たまらぬ夏のよの月",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "きかねともなをかてらるや郭公まちし五月の心ならひに",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "夕まくれをはきか花は咲ねもも鹿なきぬへき風の音かな",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "明はまつ人にかたらむほとゝきすまた里なれぬ初音きゝつと",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "年每の御秡のしるしあらませは我なに〓ををけふいのらまし",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "咲そむるあしたの原の女郞花秋をしらするつまにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "これやこの詠むるたひにしのはるゝ哀れ〓ななる秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "久かたの天の川なみあけたてはぬれてやかへる雲のはころも",
   "kana": "",
   "speaker": "雅兼卿集",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "女郞花なひくとみれは秋風の吹くる末もなつかしき哉",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "たかまとの山の裾野の夕露にかけさしそふる弓はりの月",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "忍ひつまひとりにもあらす望月のこまいつかたに心ひくらむ",
   "kana": "",
   "speaker": "れはこそはなには立けり",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "おもひしる人に見せはやをしか鳴ふたかみ山のあけほのゝ空",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "すみよしのたむけのたひにあらねとも哀はかけきおきつ白浪",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "隱れゐの木くれの月のもるのみや紅葉散よのとりところなる",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "秋くれは野原の花をませのうちに露もおとさす移してそめゆ",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "たつねこむみたにかくれのはゝそ原しつ枝に秋の色や殘ると",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "ふなてせし秋まつほとは暮しまの空吹風もすゝしかりけり",
   "kana": "",
   "speaker": "",
   "page": 119,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "秋ふかみ山風寒したひころも心してこそたつへかりけれ",
   "kana": "",
   "speaker": "雅兼卿集",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "逢坂の關もる神にことゝはむいくよかみつる望月のこま",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "おれふして竹の末葉もうつもれぬ夜〓とにまさる雪のおもさに",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "御狩する片野ゝすそとしりなかち何ときゝすの跡とゝむらん",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "あつまちの人にとはゝや甲斐か根の山にもけふのゆきや初雪",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "此たひはあかきみ佛みえたまへさてこそ後の世をもたのまめ",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "わすれしの契もかけぬ花なれとたをりし枝は忍はれそする",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "時雨とやおもひはてまし松風を梢の月のもりこさりせは",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "はつ霜は降にけりとも見ゆる哉なからの橋をてらす月かけ",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "八百よろつ久しき御代のためしとは替らぬ松の綠をそみる",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "夏ころもへたて〓〓てやかてさは夜寒の床にひとり寢よとや",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "さりともと尋ねこしちのかひもなく跡をたにみてかへる山哉",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "人の上となげきしものを今は又我さへすふるはゝかりのせき",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "むねにみつ戀の煙や雲ならん心のそらのはるゝよもなき",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "よそへつゝ我みる野邊の女郞花こひせぬ人もきてやおるらん",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "なけきつゝ夜は明かたに成ぬれといとゝ心のかきくらすかな",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "昔のみ忍はるゝ身の行末はけふこひしくやあらんとすらん",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "伊勢島や蜓ならませはをのか浦の見るめなきさに物は思はし",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "苦しさはとはぬつらさをつらしとも思はしとおもふ思ひ成鳬",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "忍ふれと戀はけしきやしるからむまつみる人のめてた顔なる",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "思ひやれ松吹風に夢さめて戀しさまさる冬のやまさと",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "山里の岩垣なれやわか戀はおもひこめつゝ年のへぬらん",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "をし鳥はすかたの池に移してやをのか思ひのほとをしるらん",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "あるしなる水たにすまぬ濁江にほのかに月のなにやとるらむ",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "たち出てねとこもさらぬ程なるをひとりふすまの妻や恨むる",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "かゝりける淚と人もみるはかりしほらし袖よ朽はてねたゝ",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "きのふとは誰か契りしこの月は十四夜とこそいふへかりけれ",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "いにしへのきのふは〓とに雲はれて今宵の月やかゝらさりけん",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "さやかなる秋のなたてに年をへても〔下關〕",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "九月の今宵わきては曇らねとかくしもはれは名にそたゝまし",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "これも又うき世にめくる妻かとて心のまゝに月をたに見す",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "世をすてゝ西へ行とは知なから見しとはいかに山のはの月",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "思へともよにゆるしなき雲のうへにいさなふ月の影も有けり",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "よの人に月みる〓とのをとられは秋そ我身のさかり成ける",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "さかりとはまたきなかけそ秋の月雲の上まて見ぬはみるかは",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "雲ゐには月の光もそふなれはいとゝ心のかゝりぬるかな",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "いひしいへは此世は夢そうれしとて包みし袖に何かとまれる",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "夢のうちに生れもしにもする事を何かうれへも喜ひもせん",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "世の中を同しまとひのうらにてもなけかぬ夢を見るよしも哉",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "涙のみかゝる袂を秋の夜は人なみ〓〓にかさすやあらまし",
   "kana": "",
   "speaker": "成通卿集",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "人をこそとはて過ぬれ定めなき世をうみにのみ汐たるゝまに",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "悲しさのいつを限りとあらはこそとはて過ぬる人をうらみめ",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "よはりゆく我みよとてや女郞花秋よりさきにいそき咲らん",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "植をきし句ひとおもへは梅の色いとゝむかしの春そ戀しき",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "うれしさをかへす〓〓もつゝむへきこけの袂のせはくも有哉",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
